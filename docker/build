#!/bin/bash

set -euo pipefail

if [[ -n "${DRAEM_DEBUG:-}" ]]; then
    set -x
fi

# Build context is always the repository root, whatever directory the caller is in.
cd "$(dirname "$0")/.."

source docker/env

function usage() {
    echo -n \
        "Usage: $(basename "$0")
Build the DRAEM container.

Options:
--no-cache  Do not use cache when building the images
--pull      Attempt to pull upstream images before building
"
}

BUILD_ARGS=()

while [[ $# -gt 0 ]]
do
    case "$1" in
        --help)
        usage
        exit 0
        ;;

        --no-cache)
        BUILD_ARGS+=(--no-cache)
        shift
        ;;

        --pull)
        BUILD_ARGS+=(--pull)
        shift
        ;;

        *)
        echo "Unknown option: $1" >&2
        usage
        exit 1
        ;;
    esac
done

if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
    docker build "${BUILD_ARGS[@]}" \
        --target dev \
        -t "$DOCKER_IMAGE_NAME" \
        -f docker/Dockerfile \
        .
fi
